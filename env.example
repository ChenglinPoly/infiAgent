# Multi-Level Agent API Server 环境变量配置
# 复制此文件为 .env 并填入你的API密钥

# API导入 - 环境变量配置模板

# === LLM API 密钥 ===

# OpenAI 官方API
OPENAI_API_KEY=sk-REDACTED

# Anthropic Claude 官方API  
ANTHROPIC_API_KEY=sk-ant-REDACTED

# Google Gemini 官方API
GEMINI_API_KEY=your-gemini-key-here

# === Custom API 配置 ===

# Custom API 密钥（如 OpenRouter）
CUSTOM_API_KEY=sk-or-v1-REDACTED

# Custom API 基础URL
CUSTOM_BASE_URL=https://openrouter.ai/api/v1

# === 其他配置 ===

# 工具服务器地址（如果工具服务器在不同端口或主机）
# TOOLS_SERVER=http://localhost:8001/

# 日志级别
# LOG_LEVEL=DEBUG

# === Docker 特定配置 ===

# 容器内端口（通常不需要修改）
# API_PORT=5002

# === 使用说明 ===
# 1. 复制此文件为 .env
# 2. 填入你的API密钥
# 3. 运行: docker-compose up -d
# 4. API将在 http://localhost:5002 可用 