n        \\\"模块重量\\\",\\n        \\\"行驶距离\\\",\\n        \\\"碳排放因子\\\"\\n      ],\\n      \\\"formula\\\": \\\"CE = W × D × EF\\\",\\n      \\\"parameters\\\": {\\n        \\\"CE\\\": \\\"碳排放量(单位：kg CO2)\\\",\\n        \\\"W\\\": \\\"模块重量(单位：吨)\\\",\\n        \\\"D\\\": \\\"行驶距离(单位：km)\\\",\\n        \\\"EF\\\": \\\"碳排放因子(单位：kg CO2/吨·km)\\\"\\n      },\\n      \\\"emission_factors\\\": {\\n        \\\"medium_truck_8t\\\": \\\"具体碳排放因子值未在论文中明确给出\\\",\\n        \\\"medium_truck_10t\\\": \\\"具体碳排放因子值未在论文中明确给出\\\",\\n        \\\"heavy_truck_30t\\\": \\\"具体碳排放因子值未在论文中明确给出\\\"\\n      }\\n    },\\n    \\\"routing_decision_process\\\": {\\n      \\\"steps\\\": [\\n        \\\"制造商通过CPI-CAN和CPI-WAN发送订单信息并检查可用供应商\\\",\\n        \\\"系统根据当前交通信息和可用链路计算各可能路径的碳排放量\\\",\\n        \\\"选择碳排放最低的供应商和路线\\\",\\n        \\\"供应商CPI-LAN负责内部物流，准备并装载材料\\\",\\n        \\\"材料按照选定的路线从供应商运送到制造商\\\",\\n        \\\"整个运输过程中，路由器根据实时交通信息和链路可用性提供路由建议\\\",\\n        \\\"如果链路不可通行或交通拥堵，路由器会避开该路线，选择当前情况下碳排放最低的替代路线\\\"\\n      ],\\n      \\\"metric_update\\\": \\\"在整个运输过程中，第一个路由器显示整个运输的碳排放量，后续路由器显示从当前节点到最终节点的结果。公司可以通过路由表检查运输的总碳排放量，比传统的通过收集数据进行计算的操作更易于访问。\\\"\\n    }\\n  },\\n  \\\"experimental_setup\\\": {\\n    \\\"scenario\\\": \\\"大湾区(GBA)的场景分析\\\",\\n    \\\"participants\\\": {\\n      \\\"suppliers\\\": \\\"四个供应商，位于不同城市的不同位置\\\",\\n      \\\"manufacturers\\\": \\\"两个制造商，位于城市的不同位置\\\"\\n    },\\n    \\\"assumptions\\\": [\\n      \\\"使用具有不同满载能力(8吨、10吨和30吨)的中型和重型卡车\\\",\\n      \\\"每个供应商和制造商的位置通过模拟随机设置\\\",\\n      \\\"每辆卡车都假设满载，具有不同的碳排放因子\\\",\\n      \\\"每次运输都是从一个供应商到一个制造商，不考虑合并\\\",\\n      \\\"场景不考虑车队运输能力和实时交通信息\\\"\\n    ],\\n    \\\"network_configuration\\\": {\\n      \\\"cpi_lans\\\": \\\"六个独立的CPI-LAN，每个供应商和制造商各一个\\\",\\n      \\\"cpi_cans\\\": \\\"三个CPI-CAN，两个供应商形成一个CPI-CAN，两个制造商形成一个CPI-CAN\\\",\\n      \\\"cpi_wan\\\": \\\"一个CPI-WAN连接所有CPI-CAN\\\"\\n    }\\n  },\\n  \\\"results_and_findings\\\": {\\n    \\\"carbon_emission_comparison\\\": {\\n      \\\"scenarios\\\": [\\n        \\\"使用8吨卡车由一个供应商