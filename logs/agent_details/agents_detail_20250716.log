cription\": \"碳排放优先（α=0.2, β=0.2, γ=0.6）\",\n        \"weights\": {\"time\": 0.2, \"cost\": 0.2, \"carbon\": 0.6}\n      },\n      {\n        \"id\": \"scenario_4\",\n        \"description\": \"均衡权重（α=0.33, β=0.33, γ=0.34）\",\n        \"weights\": {\"time\": 0.33, \"cost\": 0.33, \"carbon\": 0.34}\n      }\n    ],\n    \"baseline_methods\": [\n      {\n        \"name\": \"time_only\",\n        \"description\": \"仅考虑时间的传统路由方法\",\n        \"weights\": {\"time\": 1.0, \"cost\": 0.0, \"carbon\": 0.0}\n      },\n      {\n        \"name\": \"cost_only\",\n        \"description\": \"仅考虑成本的传统路由方法\",\n        \"weights\": {\"time\": 0.0, \"cost\": 1.0, \"carbon\": 0.0}\n      },\n      {\n        \"name\": \"carbon_only\",\n        \"description\": \"仅考虑碳排放的碳感知路由方法\",\n        \"weights\": {\"time\": 0.0, \"cost\": 0.0, \"carbon\": 1.0}\n      }\n    ],\n    \"evaluation_metrics\": [\n      {\n        \"name\": \"average_time\",\n        \"description\": \"所有路由的平均时间\",\n        \"unit\": \"小时\"\n      },\n      {\n        \"name\": \"average_cost\",\n        \"description\": \"所有路由的平均成本\",\n        \"unit\": \"元\"\n      },\n      {\n        \"name\": \"average_carbon\",\n        \"description\": \"所有路由的平均碳排放\",\n        \"unit\": \"kg CO2\"\n      },\n      {\n        \"name\": \"pareto_optimality\",\n        \"description\": \"路由结果的帕累托最优性评估\",\n        \"method\": \"计算非支配解的比例\"\n      }\n    ]\n  },\n  \"implementation_plan\": {\n    \"code_structure\": {\n      \"modules\": [\n        {\n          \"name\": \"network_generator.py\",\n          \"purpose\": \"生成CPI网络结构，包括节点、边和ALSs\"\n        },\n        {\n          \"name\": \"metric_calculator.py\",\n          \"purpose\": \"计算时间、成本和碳排放指标\"\n        },\n        {\n          \"name\": \"multi_objective_router.py\",\n          \"purpose\": \"实现多目标优化的A*路由算法\"\n        },\n        {\n          \"name\": \"baseline_router.py\",\n          \"purpose\": \"实现基线路由算法（单一目标）\"\n        },\n        {\n          \"name\": \"experiment_runner.py\",\n          \"purpose\": \"运行实验并收集结果\"\n        },\n        {\n          \"name\": \"result_analyzer.py\",\n          \"purpose\": \"分析实验结果并生成图表\"\n        }\n      ]\n    },\n    \"data_structures\": {\n      \"network\": \"使用NetworkX的DiGraph表示CPI网络\",\n      \"node\": \"包含位置、类型（供应商/制造商/边界）等属性的字典\",\n      \"edge\": \"包含距离、时间、成本、碳排放因子等属性的字典\",\n      \"route\": \"包含路径、总时间、总成本、总碳排放等属性的字典\"\n    },\n    \"algorithm_pseudocode\": {\n      \"multi_objective_a_star\": [\n        \"function MultiObjectiveAStar(start, goal, alpha, beta, gamma):\",\n        \"    openSet = {start}  // 存放待探索的节点\",\n        \"    closedSet = {}    // 存放已探索的节点\",\n        \"    g_score = {start: 0}  // 从起点到当前节点的实际成本\",\n        \"    f_score = {start: Heuristic(start, goal, alpha, beta, gamma)}  // 估计总成本\",\n        \"    \",\n        \"    while openSet is not empty:\",\n        \"        current = 从openSet中选取f_score最小的节点\",\n        \"        if current == goal:\",\n        \"            return ReconstructPath(current)  // 找到路径\",\n        \"        \",\n        \"        openSet.remove(current)\",\n        \"        closedSet.add(current)\",\n        \"        \",\n        \"        for each neighbor of current:\",\n        \"            if neighbor in closedSet:\",\n        \"                continue\",\n        \"            \",\n        \"            // 计算综合成本\",\n        \"            time_cost = CalculateTime(current, neighbor)\",\n        \"            monetary_cost = CalculateCost(current, neighbor)\",\n        \"            carbon_cost = CalculateCarbon(current, neighbor)\",\n        \"            \",\n        \"            // 归一化并加权\",\n        \"            normalized_time = Normalize(time_cost, time_min, time_max)\",\n        \"            normalized_cost = Normalize(monetary_cost, cost_min, cost_max)\",\n        \"            normalized_carbon = Normalize(carbon_cost, carbon_min, carbon_max)\",\n        \"            \",\n        \"            weighted_cost = alpha * normalized_time + beta * normalized_cost + gamma * normalized_carbon\",\n        \"            \",\n        \"            tentative_g_score = g_score[current] + weighted_cost\",\n        \"            \",\n        \"            if neighbor not in openSet or tentative_g_score < g_score[neighbor]:\",\n        \"                came_from[neighbor] = current\",\n        \"                g_score[neighbor] = tentative_g_score\",\n        \"                f_score[neighbor] = g_score[neighbor] + Heuristic(neighbor, goal, alpha, beta, gamma)\",\n        \"                if neighbor not in openSet:\",\n        \"                    openSet.add(neighbor)\",\n        \"    \",\n        \"    return failure  // 无路径\"\n      ],\n      \"heuristic_function\": [\n        \"function Heuristic(node, goal, alpha, beta, gamma):\",\n        \"    // 估计从node到goal的综合成本\",\n        \"    estimated_time = EstimateTime(node, goal)\",\n        \"    estimated_cost = EstimateCost(node, goal)\",\n        \"    estimated_carbon = EstimateCarbon(node, goal)\",\n        \"    \",\n        \"    // 归一化并加权\",\n        \"    normalized_time = Normalize(estimated_time, time_min, time_max)\",\n        \"    normalized_cost = Normalize(estimated_cost, cost_min, cost_max)\",\n        \"    normalized_carbon = Normalize(estimated_carbon, carbon_min, carbon_max)\",\n        \"    \",\n        \"    return alpha * normalized_time + beta * normalized_cost + gamma * normalized_carbon\"\n      ]\n    }\n  },\n  \"expected_results\": {\n    \"analysis_methods\": [\n      \"比较不同权重设置下的路由结果\",\n      \"评估多目标优化方法与单一目标基线方法的差异\",\n      \"分析权重变化对路由决策的敏感性\",\n      \"生成帕累托前沿，展示不同权重组合下的非支配解\"\n    ],\n    \"expected_findings\": [\n      \"多目标优化路由协议能够在时间、成本和碳排放之间取得更好的平衡\",\n      \"与单一目标优化相比，多目标优化能够提供更多样化的路由选择\",\n      \"不同场景下权重设置的最佳实践建议\",\n      \"在大规模网络中，多目标优化的计算复杂性挑战及解决方案\"\n    ],\n    \"visualization_plans\": [\n      {\n        \"type\": \"3D散点图\",\n        \"purpose\": \"展示不同路由方案在时间、成本、碳排放三个维度上的分布\"\n      },\n      {\n        \"type\": \"雷达图\",\n        \"purpose\": \"比较不同方法在各评估指标上的相对表现\"\n      },\n      {\n        \"type\": \"热力图\",\n        \"purpose\": \"展示不同权重组合对路由结果的影响\"\n      },\n      {\n        \"type\": \"网络图\",\n        \"purpose\": \"可视化不同方法选择的路由路径\"\n      }\n    ]\n  },\n  \"timeline\": {\n    \"phase1\": {\n      \"name\": \"环境设置和数据准备\",\n      \"duration\": \"1周\",\n      \"tasks\": [\n        \"设置Python环境和安装必要库\",\n        \"实现网络生成器\",\n        \"生成测试数据集\"\n      ]\n    },\n    \"phase2\": {\n      \"name\": \"算法实现\",\n      \"duration\": \"2周\",\n      \"tasks\": [\n        \"实现度量计算器\",\n        \"实现多目标A*路由算法\",\n        \"实现基线路由算法\"\n      ]\n    },\n    \"phase3\": {\n      \"name\": \"实验运行和数据收集\",\n      \"duration\": \"1周\",\n      \"tasks\": [\n        \"在小规模网络上运行实验\",\n        \"在大规模网络上运行实验\",\n        \"收集实验数据\"\n      ]\n    },\n    \"phase4\": {\n      \"name\": \"结果分析和可视化\",\n      \"duration\": \"1周\",\n      \"tasks\": [\n        \"分析实验结果\",\n        \"生成可视化图表\",\n        \"撰写研究报告\"\n      ]\n    }\n  }\n}"
