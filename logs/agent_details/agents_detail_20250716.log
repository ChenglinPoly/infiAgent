看运输的总碳排放量，比传统的通过收集数据进行计算的操作更易于访问。\\\",\\n      \\\"benefits\\\": [\\n        \\\"提供碳排放最低的路由决策\\\",\\n        \\\"实时响应交通状况变化\\\",\\n        \\\"便于监控和报告碳排放数据\\\",\\n        \\\"支持企业碳中和目标\\\"\\n      ]\\n    },\\n    \\\"comparison_with_traditional_routing\\\": {\\n      \\\"metric_difference\\\": {\\n        \\\"traditional\\\": \\\"传统路由算法通常以最短路径、最短时间或最低成本作为度量标准\\\",\\n        \\\"carbon_aware\\\": \\\"碳感知路由算法以最低碳排放作为主要度量标准\\\"\\n      },\\n      \\\"optimization_focus\\\": {\\n        \\\"traditional\\\": \\\"传统方法主要关注效率和成本优化\\\",\\n        \\\"carbon_aware\\\": \\\"碳感知方法优先考虑环境影响和可持续性\\\"\\n      },\\n      \\\"decision_factors\\\": {\\n        \\\"traditional\\\": \\\"主要考虑距离、时间和成本因素\\\",\\n        \\\"carbon_aware\\\": \\\"综合考虑模块重量、距离和碳排放因子\\\"\\n      },\\n      \\\"network_integration\\\": {\\n        \\\"traditional\\\": \\\"通常在单一网络或企业内部运作\\\",\\n        \\\"carbon_aware\\\": \\\"基于CPI网络框架，整合多个参与者，实现资源共享和信息协作\\\"\\n      },\\n      \\\"environmental_impact\\\": {\\n        \\\"traditional\\\": \\\"环境因素通常是次要考虑或完全不考虑\\\",\\n        \\\"carbon_aware\\\": \\\"将环境影响作为主要决策因素，直接优化碳排放\\\"\\n      },\\n      \\\"adaptability\\\": {\\n        \\\"traditional\\\": \\\"可能对交通状况变化有有限的响应\\\",\\n        \\\"carbon_aware\\\": \\\"根据实时交通信息和链路可用性动态调整路线，确保在变化条件下仍能保持碳排放最小化\\\"\\n      }\\n    },\\n    \\\"experimental_validation\\\": {\\n      \\\"scenario\\\": \\\"大湾区(GBA)的场景分析\\\",\\n      \\\"setup\\\": {\\n        \\\"participants\\\": {\\n          \\\"suppliers\\\": \\\"四个供应商，位于不同城市的不同位置\\\",\\n          \\\"manufacturers\\\": \\\"两个制造商，位于城市的不同位置\\\"\\n        },\\n        \\\"transportation\\\": \\\"使用具有不同满载能力(8吨、10吨和30吨)的中型和重型卡车\\\",\\n        \\\"network_configuration\\\": {\\n          \\\"cpi_lans\\\": \\\"六个独立的CPI-LAN，每个供应商和制造商各一个\\\",\\n          \\\"cpi_cans\\\": \\\"三个CPI-CAN，两个供应商形成一个CPI-CAN，两个制造商形成一个CPI-CAN\\\",\\n          \\\"cpi_wan\\\": \\\"一个CPI-WAN连接所有CPI-CAN\\\"\\n        }\\n      },\\n      \\\"results\\\": \\\"实验结果显示，在CPI网络下的集成情况具有最低的碳排放量，考虑到了现实世界的交通信息。由于最近的