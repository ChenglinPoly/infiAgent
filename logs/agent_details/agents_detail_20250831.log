\n        except Exception as e:\n            print(f\"Error writing file {filename}: {e}\")\n\nif __name__ == \"__main__\":\n    # Example usage:\n    generate_star_image(\"code_run/star_shape.png\", 200, 200, (1.0, 0.0, 0.0)) # Red star\n"
