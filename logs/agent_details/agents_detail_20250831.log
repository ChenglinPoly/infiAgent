  "content": "import cairo\nimport math\n\ndef draw_star(ctx, cx, cy, r, n_points, inner_ratio):\n    \"\"\"\n    Draws a star shape.\n\n    Args:\n        ctx: Cairo context.\n        cx (float): Center x-coordinate.\n        cy (float): Center y-coordinate.\n        r (float): Outer radius of the star.\n        n_points (int): Number of points of the star.\n        inner_ratio (float): Ratio of inner radius to outer radius.\n    \"\"\"\n    inner_r = r * inner_ratio\n    angle_step = math.pi / n_points\n\n    for i in range(2 * n_points):\n        current_r = r if i % 2 == 0 else inner_r\n        angle = i * angle_step - math.pi / 2  # Start from top\n        x = cx + current_r * math.cos(angle)\n        y = cy + current_r * math.sin(angle)\n        if i == 0:\n            ctx.move_to(x, y)\n        else:\n            ctx.line_to(x, y)\n    ctx.close_path()\n\ndef generate_star_image(filename, width, height, color, n_points=5, inner_ratio=0.4):\n    \"\"\"\n    Generates a PNG image of a star shape.\n\n    Args:\n        filename (str): Output filename (e.g., \"star.png\").\n        width (int): Image width.\n        height (int): Image height.\n        color (tuple): RGB color tuple (0.0-1.0).\n        n_points (int): Number of points of the star (default is 5 for a pentagram).\n        inner_ratio (float): Ratio of inner radius to outer radius (default is 0.4).\n    \"\"\"\n    with cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height) as surface:\n        ctx = cairo.Context(surface)\n\n        # Set background to white\n        ctx.set_source_rgb(1, 1, 1)\n        ctx.paint()\n\n        # Set star color\n        ctx.set_source_rgb(*color)\n\n        # Calculate center and radius for the star\n        cx, cy = width / 2, height / 2\n        radius = min(width, height) / 2 * 0.8  # Adjust radius to fit within the image\n\n        draw_star(ctx, cx, cy, radius, n_points, inner_ratio)\n        ctx.fill()\n\n        surface.write_to_png(filename)\n\nif __name__ == \"__main__\":\n    # Example usage:\n    generate_star_image(\"code_run/star_shape.png\", 200, 200, (1.0, 0.0, 0.0)) # Red star\n",
