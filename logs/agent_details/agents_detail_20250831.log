文件内容：
```python
def fibonacci(n):
    if n <= 0:
        return []
    elif n == 1:
        return [0]
    else:
        list = [0, 1]
        while len(list) < n:
            next_fib = list[-1] + list[-2]
            list.append(next_fib)
        return list

if __name__ == '__main__':
    n = 10  # 计算前10个斐波那契数
    result = fibonacci(n)
    print(f'前{n}个斐波那契数是: {result}')
```

