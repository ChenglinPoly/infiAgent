  "content": "import math\nfrom PIL import Image, ImageDraw\nimport os\n\ndef draw_star_pil(draw, cx, cy, r, n_points, inner_ratio, fill_color):\n    inner_r = r * inner_ratio\n    angle_step = math.pi / n_points\n    points = []\n    for i in range(2 * n_points):\n        current_r = r if i % 2 == 0 else inner_r\n        angle = i * angle_step - math.pi / 2  # Start from top\n        x = cx + current_r * math.cos(angle)\n        y = cy + current_r * math.sin(angle)\n        points.append((x, y))\n    draw.polygon(points, fill=fill_color)\n\ndef generate_star_image(filename, width, height, color, n_points=5, inner_ratio=0.4):\n    img = Image.new(\"RGB\", (width, height), (255, 255, 255))  # White background\n    draw = ImageDraw.Draw(img)\n\n    # Convert color from 0.0-1.0 to 0-255\n    fill_color = (int(color[0] * 255), int(color[1] * 255), int(color[2] * 255))\n\n    cx, cy = width / 2, height / 2\n    radius = min(width, height) / 2 * 0.8\n\n    draw_star_pil(draw, cx, cy, radius, n_points, inner_ratio, fill_color)\n\n    try:\n        # Ensure the directory exists\n        os.makedirs(os.path.dirname(filename), exist_ok=True)\n        img.save(filename)\n    except Exception as e:\n        print(f\"Error writing file {filename}: {e}\")\n\nif __name__ == \"__main__\":\n    generate_star_image(\"/workspace/tasks/shape_test_001/code_run/star_shape.png\", 200, 200, (1.0, 0.0, 0.0)) # Red star",
  "file_path": "code_run/generate_star.py"
}
