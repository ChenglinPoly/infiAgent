<tool_use:content>from PIL import Image, ImageDraw

def draw_triangle(output_path="triangle.png", size=(200, 200), color="red"):
    """
    Draws a triangle and saves it as a PNG image.

    Args:
        output_path (str): The path to save the output PNG file.
        size (tuple): The size of the image (width, height).
        color (str): The color of the triangle.
    """
    img = Image.new("RGB", size, "white")
    draw = ImageDraw.Draw(img)

    # Define the vertices of the triangle
    # For a 200x200 image, a simple equilateral triangle can be defined as:
    # Top point: (width/2, height/4)
    # Bottom-left point: (width/4, height*3/4)
    # Bottom-right point: (width*3/4, height*3/4)
    width, height = size
    points = [
        (width / 2, height / 4),
        (width / 4, height * 3 / 4),
        (width * 3 / 4, height * 3 / 4)
    ]

    draw.polygon(points, fill=color)
    img.save(output_path)
    print(f"Triangle saved to {output_path}")

if __name__ == "__main__":
    draw_triangle(output_path="code_run/triangle.png")</tool_use:content>
