2025-09-14 16:45:32 - INFO - [writing_agent] 工具参数: {
  "file_path": "code_run/draw_star.py",
  "content": "\nimport matplotlib.pyplot as plt\nimport numpy as np\n\ndef draw_star(path):\n    # 创建一个图形和轴\n    fig, ax = plt.subplots(figsize=(6, 6))\n\n    # 五角星的顶点坐标\n    # 外圈顶点\n    outer_radius = 1\n    outer_angles = np.linspace(0, 2 * np.pi, 5, endpoint=False) + np.pi/2 # 旋转90度让一个角朝上\n    outer_points = np.array([[outer_radius * np.cos(a), outer_radius * np.sin(a)] for a in outer_angles])\n\n    # 内圈顶点\n    inner_radius = outer_radius * np.sin(np.pi/10) / np.sin(7*np.pi/10) # 计算内圈半径\n    inner_angles = np.linspace(0, 2 * np.pi, 5, endpoint=False) + np.pi/2 + np.pi/5 # 旋转并偏移\n    inner_points = np.array([[inner_radius * np.cos(a), inner_radius * np.sin(a)] for a in inner_angles])\n\n    # 交错连接内外圈顶点形成五角星\n    star_points = []\n    for i in range(5):\n        star_points.append(outer_points[i])\n        star_points.append(inner_points[i])\n    star_points.append(outer_points[0]) # 闭合图形\n\n    star_points = np.array(star_points)\n\n    # 绘制五角星\n    ax.plot(star_points[:, 0], star_points[:, 1], 'b-', linewidth=2)\n    ax.fill(star_points[:, 0], star_points[:, 1], 'gold', edgecolor='blue', linewidth=2)\n\n    # 设置坐标轴范围和比例\n    ax.set_xlim([-1.2, 1.2])\n    ax.set_ylim([-1.2, 1.2])\n    ax.set_aspect('equal', adjustable='box')\n\n    # 隐藏坐标轴\n    ax.axis('off')\n\n    # 保存为PNG文件\n    plt.savefig(path, transparent=True)\n    plt.close()\n\nif __name__ == \"__main__\":\n    draw_star(\"star.png\")\n"
}
