```python
import matplotlib.pyplot as plt
import numpy as np

def draw_triangle(output_path="triangle.png"):
    # 定义三角形的顶点坐标
    vertices = np.array([[0, 0], [1, 0], [0.5, np.sqrt(3)/2], [0, 0]])

    # 创建图形和轴
    fig, ax = plt.subplots()

    # 绘制三角形
    ax.plot(vertices[:, 0], vertices[:, 1], 'b-')

    # 设置轴的范围
    ax.set_xlim([-0.1, 1.1])
    ax.set_ylim([-0.1, 1.1])

    # 隐藏坐标轴
    ax.axis('off')

    # 保存为 PNG 文件
    plt.savefig(output_path, bbox_inches='tight', pad_inches=0)
    plt.close(fig)

if __name__ == "__main__":
    draw_triangle()
```
请执行这个脚本，生成 `triangle.png` 文件。
